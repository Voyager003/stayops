# Minimal app compose

STAYOPS_IMAGE=ghcr.io/voyager003/stayops:latest
MOCK_OTA_IMAGE=ghcr.io/voyager003/stayops-mock-ota:latest
API_DOMAIN=api.example.com
MOCK_OTA_HTPASSWD_PATH=./.htpasswd

# StayOps API
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.stayops.internal:5432/stayops
SPRING_DATASOURCE_USERNAME=stayops
SPRING_DATASOURCE_PASSWORD=replace-with-runtime-password
TOSS_SECRET_KEY=replace-with-runtime-secret
MOCK_OTA_ENDPOINT=http://mock-ota-app:8081
MOCK_OTA_BASIC_AUTH_USERNAME=
MOCK_OTA_BASIC_AUTH_PASSWORD=

# Mock OTA
MOCK_OTA_PMS_WEBHOOK_URL=http://app:8080/api/v1/properties/{propertyId}/channels/webhook/{channelCode}
