# Minimal app compose

STAYOPS_IMAGE=ghcr.io/voyager003/stayops:latest
MOCK_OTA_IMAGE=ghcr.io/voyager003/stayops-mock-ota:latest
API_DOMAIN=api.example.com
MOCK_OTA_HTPASSWD_PATH=./.htpasswd

# StayOps API
SPRING_MONGODB_URI=mongodb://stayops_app:replace-with-runtime-password@minimal-mongo.stayops.internal:27017/stayops?replicaSet=rs0&directConnection=true&retryWrites=true&authSource=admin
TOSS_SECRET_KEY=replace-with-runtime-secret
MOCK_OTA_ENDPOINT=http://api.example.com/mock-ota

# Mock OTA
MOCK_OTA_PMS_WEBHOOK_URL=http://api.example.com/api/v1/properties/{propertyId}/channels/webhook/{channelCode}
