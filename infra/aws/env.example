STAYOPS_IMAGE=ghcr.io/voyager003/stayops:latest
GRAFANA_PASSWORD=change-me
TOSS_SECRET_KEY=replace-with-runtime-secret

MONGO_REPLICA_SET=rs0
MONGO1_HOST=10.0.2.10
MONGO2_HOST=10.0.2.11
MONGO_ARBITER_HOST=10.0.1.10

SPRING_MONGODB_URI=mongodb://10.0.2.10:27017,10.0.2.11:27017/stayops?replicaSet=rs0&w=majority&readPreference=primary
SPRING_DATA_REDIS_HOST=redis
MOCK_OTA_ENDPOINT=https://mock-ota.example.com

LOKI_URL=http://boot-private-ip:3100/loki/api/v1/push
