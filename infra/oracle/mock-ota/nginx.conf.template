server {
    listen 80;
    server_name ${MOCK_OTA_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${MOCK_OTA_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${MOCK_OTA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MOCK_OTA_DOMAIN}/privkey.pem;

    location ~ ^/api/v1/(simulate|ari/clear) {
        auth_basic "Mock OTA control";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://mock-ota-app:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://mock-ota-app:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
