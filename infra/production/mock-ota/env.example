# Production Mock OTA compose

MOCK_OTA_IMAGE=ghcr.io/voyager003/stayops-mock-ota:latest
MOCK_OTA_DOMAIN=mock-ota.stayops.internal
MOCK_OTA_HTPASSWD_PATH=./.htpasswd

# Mock OTA -> StayOps webhook callback.
# In the production-like topology, Mock OTA is private, but it behaves like an
# external channel by calling the public StayOps API endpoint.
MOCK_OTA_PMS_WEBHOOK_URL=https://api.example.com/api/v1/properties/{propertyId}/channels/webhook/{channelCode}
