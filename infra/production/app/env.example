# Production app compose

STAYOPS_IMAGE=ghcr.io/voyager003/stayops:latest

# StayOps API
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.stayops.internal:5432/stayops
SPRING_DATASOURCE_USERNAME=stayops
SPRING_DATASOURCE_PASSWORD=replace-with-runtime-password
SPRING_DATA_REDIS_HOST=redis.stayops.internal
SPRING_DATA_REDIS_PORT=6379
STAYOPS_INSTANCE_ID=app-1
TOSS_SECRET_KEY=replace-with-runtime-secret
MOCK_OTA_ENDPOINT=http://mock-ota.stayops.internal
MOCK_OTA_BASIC_AUTH_USERNAME=replace-with-runtime-username
MOCK_OTA_BASIC_AUTH_PASSWORD=replace-with-runtime-password

# App EC2 agent
LOKI_URL=http://observability.stayops.internal:3100/loki/api/v1/push
HOSTNAME=app-1
