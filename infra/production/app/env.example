# Production app compose

STAYOPS_IMAGE=ghcr.io/voyager003/stayops:latest

# StayOps API
SPRING_MONGODB_URI=mongodb://stayops_app:replace-with-runtime-password@10.0.2.10:27017,10.0.2.11:27017,10.0.2.12:27017/stayops?replicaSet=rs0&w=majority&readPreference=primary&retryWrites=true&authSource=admin
SPRING_DATA_REDIS_HOST=replace-with-shared-redis-endpoint
SPRING_DATA_REDIS_PORT=6379
STAYOPS_INSTANCE_ID=app-1
TOSS_SECRET_KEY=replace-with-runtime-secret
MOCK_OTA_ENDPOINT=http://mock-ota.stayops.internal

# Observability
MONGO1_HOST=10.0.2.10
MONGO2_HOST=10.0.2.11
MONGO3_HOST=10.0.2.12
MONGO_HOST=10.0.2.10
MONGO_EXPORTER_HOST=10.0.2.10
PROMETHEUS_CONFIG_PATH=./prometheus.yml
GRAFANA_PASSWORD=replace-with-admin-password
