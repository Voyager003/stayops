aws_region = "ap-northeast-2"

deployment_topology = "minimal"
environment         = "minimal"

availability_zones = [
  "ap-northeast-2a"
]

vpc_cidr = "10.10.0.0/16"

public_subnet_cidrs = [
  "10.10.101.0/24"
]

private_subnet_cidrs = [
  "10.10.10.0/24"
]

ami_id = "ami-replace-with-runtime-ami"

minimal_app_instance_type   = "t3.small"
minimal_mongo_instance_type = "t3.small"

root_volume_size_gb       = 30
mongo_root_volume_size_gb = 50

# Optional. Defaults to stayops-minimal-artifacts-<account-id>.
# artifact_bucket_name = "stayops-minimal-artifacts-123456789012"

# Optional. Set this to attach S3/SSM bootstrap deploy permissions to the
# GitHub Actions role used by AWS_TERRAFORM_ROLE_ARN.
# github_actions_role_name = "stayops-github-terraform-role"
