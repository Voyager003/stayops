aws_region = "ap-northeast-2"

# production: 8 EC2 production-like topology with ALB and observability.
# minimal: low-cost topology with one public app EC2 and one private MongoDB EC2.
deployment_topology = "production"

availability_zones = [
  "ap-northeast-2a",
  "ap-northeast-2c"
]

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.101.0/24",
  "10.0.102.0/24"
]

private_subnet_cidrs = [
  "10.0.10.0/24",
  "10.0.20.0/24"
]

ami_id              = "ami-replace-with-runtime-ami"
acm_certificate_arn = "arn:aws:acm:ap-northeast-2:123456789012:certificate/replace-me"

app_instance_type           = "t3.small"
mongo_instance_type         = "t3.small"
redis_instance_type         = "t3.micro"
mock_ota_instance_type      = "t3.micro"
observability_instance_type = "t3.small"
minimal_app_instance_type   = "t3.small"
minimal_mongo_instance_type = "t3.small"

root_volume_size_gb       = 30
mongo_root_volume_size_gb = 50

# Optional. Defaults to stayops-prod-artifacts-<account-id>.
# artifact_bucket_name = "stayops-prod-artifacts-123456789012"

# Optional. Set this to attach S3/SSM bootstrap deploy permissions to the
# GitHub Actions role used by AWS_TERRAFORM_ROLE_ARN.
# github_actions_role_name = "stayops-github-terraform-role"
