# Local payment/runtime environment
#
# Copy this file to .env.local and replace placeholder values locally.
# Do not commit real keys.

# Server-side Toss Payments secret key used by stayops-api.
TOSS_SECRET_KEY=replace-with-local-toss-secret-key

# Optional. Defaults to Toss Payments v1 payments API when omitted.
TOSS_BASE_URL=https://api.tosspayments.com/v1/payments

# Mock OTA webhook target when the app also runs inside Docker.
MOCK_OTA_PMS_WEBHOOK_URL=http://app:8080/api/v1/properties/{propertyId}/channels/webhook/{channelCode}
